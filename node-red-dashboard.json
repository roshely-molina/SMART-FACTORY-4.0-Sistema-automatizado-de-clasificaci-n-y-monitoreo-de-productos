  {
    "id": "sf_fn_cmd",
    "type": "function",
    "z": "sf_tab4",
    "name": "Validar órdenes de dashboard",
    "func": "// Aceptar exclusivamente los comandos aprobados y la telemetria vigente.\nconst key=String(msg.payload||'').trim().toUpperCase();\nconst habilitados=['I','P','R','A','U','1','2','3','F','Z'];\nif(!habilitados.includes(key)) return null;\nconst s=flow.get('sf_last');\nif(!s || Date.now()-s.recibido>=9000){node.warn('No hay telemetria reciente; orden bloqueada');return null;}\nif(key==='I' && s.estado!=='DETENIDA') return null;\nif(key==='P' && s.estado!=='MARCHA') return null;\nif(key==='R' && !['ERROR_SENSOR','EMERGENCIA'].includes(s.estado)) return null;\nif(['A','U','Z'].includes(key) && s.estado!=='DETENIDA') return null;\nif(key==='F' && s.estado!=='MARCHA') return null;\nmsg.payload=key;\nmsg.topic='smartfactory/demo4821/comandos';\nmsg.qos=0;\nmsg.retain=false;\nreturn msg;",
