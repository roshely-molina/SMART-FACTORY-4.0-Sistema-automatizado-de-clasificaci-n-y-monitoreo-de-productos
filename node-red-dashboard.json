  {
    "id": "sf_ui_template",
    "type": "ui-template",
    "z": "sf_tab4",
    "group": "sf_group4",
    "page": "",
    "ui": "sf_base4",
    "name": "Panel SMART FACTORY 4.0",
    "order": 1,
    "width": "12",
    "height": "17",
    "head": "",
    "format": "<template>\n  <div class=\"sf-panel\">\n    <div class=\"sf-head\">\n      <div><div class=\"sf-eyebrow\">CENTRO DE CONTROL · INDUSTRIA 4.0</div><h1>SMART FACTORY <span>4.0</span></h1><div class=\"sf-sub\">Clasificación industrial · Wokwi ESP32 + MQTT + Node-RED</div></div>\n      <div class=\"sf-status\" :class=\"online ? 'sf-online' : 'sf-offline'\"><span class=\"sf-dot\"></span>{{online ? 'ESP32 CONECTADO' : 'SIN TELEMETRÍA'}}</div>\n    </div>\n    <div class=\"sf-alert\" v-if=\"s.alarma || s.estado==='ERROR_SENSOR' || s.estado==='EMERGENCIA'\">⚠ {{s.estado==='EMERGENCIA' ? 'PARO DE EMERGENCIA' : 'ALERTA DE DETECCIÓN'}} — revisar el sistema antes de restablecer</div>\n    <div class=\"sf-cards\">\n      <div class=\"sf-card\"><div class=\"sf-k\">PRODUCTOS PROCESADOS</div><div class=\"sf-n\">{{num(s.procesados)}}</div><div class=\"sf-note\">Total de piezas de salida</div></div>\n      <div class=\"sf-card\"><div class=\"sf-k\">ADECUADOS</div><div class=\"sf-n sf-green\">{{num(s.adecuados)}}</div><div class=\"sf-note\">Piezas aceptadas</div></div>\n      <div class=\"sf-card\"><div class=\"sf-k\">RECHAZADOS</div><div class=\"sf-n sf-yellow\">{{num(rechazos)}}</div><div class=\"sf-note\">Pequeños + grandes</div></div>\n      <div class=\"sf-card\"><div class=\"sf-k\">CALIDAD</div><div class=\"sf-n sf-blue\">{{num(s.calidad)}}%</div><div class=\"sf-note\">Productos adecuados / procesados</div></div>\n    </div>\n    <div class=\"sf-columns\">\n      <section class=\"sf-section\">\n        <div class=\"sf-section-title\">ESTADO DE PRODUCCIÓN <span class=\"sf-chip\" :class=\"s.estado==='MARCHA' ? 'sf-okchip' : 'sf-warnchip'\">{{s.estado || 'SIN_DATOS'}}</span></div>\n        <div class=\"sf-stategrid\">\n          <div><span>Modo</span><strong>{{s.modo || '—'}}</strong></div>\n          <div><span>Última clasificación</span><strong :class=\"{'sf-green':s.tamano==='ADECUADO','sf-yellow':s.tamano==='PEQUENO','sf-red':s.tamano==='GRANDE'}\">{{s.tamano || '—'}}</strong></div>\n          <div><span>Altura del último paquete</span><strong>{{num(s.altura_cm)}} cm</strong></div>\n          <div><span>Velocidad seleccionada</span><strong>Nivel {{num(s.velocidad)}}</strong></div>\n          <div><span>Errores registrados</span><strong class=\"sf-red\">{{num(s.fallos)}}</strong></div>\n          <div><span>Último dato recibido</span><strong>{{s.hora || '—'}} · {{s.edad || 0}} s</strong></div>\n        </div>\n        <div class=\"sf-section-title sf-mt\">DISTRIBUCIÓN POR TAMAÑO</div>\n        <div class=\"sf-barrow\"><span>Adecuados</span><div class=\"sf-track\"><div class=\"sf-fill sf-fillgreen\" :style=\"{width:pct(s.adecuados)+'%'}\"></div></div><b>{{num(s.adecuados)}}</b></div>\n        <div class=\"sf-barrow\"><span>Pequeños</span><div class=\"sf-track\"><div class=\"sf-fill sf-fillyellow\" :style=\"{width:pct(s.pequenos)+'%'}\"></div></div><b>{{num(s.pequenos)}}</b></div>\n        <div class=\"sf-barrow\"><span>Grandes</span><div class=\"sf-track\"><div class=\"sf-fill sf-fillred\" :style=\"{width:pct(s.grandes)+'%'}\"></div></div><b>{{num(s.grandes)}}</b></div>\n        <p class=\"sf-hint\">Estadísticas de la simulación: los tamaños AUTO son virtuales y los ULTRA provienen del HC-SR04.</p>\n      </section>\n      <section class=\"sf-section\">\n        <div class=\"sf-section-title\">CONTROL REMOTO DE LA BANDA</div>\n        <div class=\"sf-controls\">\n          <button class=\"sf-btn sf-start\" :disabled=\"!online || s.estado!=='DETENIDA'\" @click=\"cmd('I')\">▶ INICIAR</button>\n          <button class=\"sf-btn sf-stop\" :disabled=\"!online || s.estado!=='MARCHA'\" @click=\"cmd('P')\">■ PAUSAR</button>\n          <button class=\"sf-btn sf-reset\" :disabled=\"!online || !['ERROR_SENSOR','EMERGENCIA'].includes(s.estado)\" @click=\"cmd('R')\">↻ RESTABLECER</button>\n        </div>\n        <div class=\"sf-label\">MODO DE OPERACIÓN <small>(solo con la banda detenida)</small></div>\n        <div class=\"sf-controls\"><button class=\"sf-btn sf-alt\" :disabled=\"!online || s.estado!=='DETENIDA'\" @click=\"cmd('A')\">AUTO</button><button class=\"sf-btn sf-alt\" :disabled=\"!online || s.estado!=='DETENIDA'\" @click=\"cmd('U')\">ULTRASÓNICO</button></div>\n        <div class=\"sf-label\">VELOCIDAD DE PRODUCCIÓN</div>\n        <div class=\"sf-controls\"><button v-for=\"v in [1,2,3]\" :key=\"v\" class=\"sf-btn\" :class=\"s.velocidad===v ? 'sf-selected' : 'sf-alt'\" :disabled=\"!online\" @click=\"cmd(String(v))\">{{v===1?'LENTA':v===2?'MEDIA':'RÁPIDA'}}</button></div>\n        <div class=\"sf-divider\"></div>\n        <div class=\"sf-controls\"><button class=\"sf-btn sf-warn\" :disabled=\"!online || s.estado!=='MARCHA'\" @click=\"cmd('F')\">⚠ SIMULAR ERROR</button><button class=\"sf-btn sf-alt\" :disabled=\"!online || s.estado!=='DETENIDA'\" @click=\"cmd('Z')\">PONER CONTADORES A CERO</button></div>\n        <p class=\"sf-hint\">Última orden enviada: <strong>{{ultimaOrden || 'Ninguna'}}</strong>. Verifica el estado recibido: pulsar un botón no confirma por sí solo la ejecución.</p>\n        <p class=\"sf-hint\">El botón PAUSAR es una orden de software. No sustituye un paro de emergencia físico.</p>\n      </section>\n    </div>\n    <section class=\"sf-section sf-chartsection\">\n      <div class=\"sf-section-title\">PRODUCCIÓN EN TIEMPO REAL <span class=\"sf-muted\">historial reciente · muestras de 2 s</span></div>\n      <div class=\"sf-chartmeta\"><div><b>{{num(s.rendimiento_hora)}}</b> <small>piezas/hora estimadas</small></div><div><b>{{num(s.generados)}}</b> <small>piezas generadas</small></div></div>\n      <svg class=\"sf-chart\" viewBox=\"0 0 100 55\" preserveAspectRatio=\"none\" aria-label=\"Tendencia de piezas procesadas\">\n        <line x1=\"0\" y1=\"52\" x2=\"100\" y2=\"52\" stroke=\"#334155\" stroke-width=\"0.5\"/>\n        <line x1=\"0\" y1=\"28\" x2=\"100\" y2=\"28\" stroke=\"#334155\" stroke-dasharray=\"2 2\" stroke-width=\"0.4\"/>\n        <polyline :points=\"linea\" stroke=\"#38bdf8\" stroke-width=\"1.4\" vector-effect=\"non-scaling-stroke\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n      <p class=\"sf-hint\">Curva acumulada de productos procesados, calculada únicamente con los mensajes MQTT recibidos.</p>\n    </section>\n    <div class=\"sf-footer\">SMART FACTORY 4.0 · Prototipo educativo virtual · Control local prioritario ante fallos</div>\n  </div>\n</template>\n<script>\nexport default {\n  data(){ return {ultimaOrden:''} },\n  computed:{\n    s(){ return this.msg?.payload || {} },\n    online(){ return this.s.online === true },\n    rechazos(){ return Number(this.s.pequenos||0)+Number(this.s.grandes||0) },\n    linea(){\n      const h=this.s.historia || [];\n      if(h.length===0) return '0,52 100,52';\n      const v=h.map(a=>Number(a.procesadas||0));\n      const mi=Math.min(...v), ma=Math.max(...v), delta=Math.max(1,ma-mi);\n      return v.map((n,i)=>`${(i/Math.max(1,v.length-1)*100).toFixed(2)},${(52-(n-mi)/delta*43).toFixed(2)}`).join(' ');\n    }\n  },\n  methods:{\n    num(x){ return Number(x||0).toLocaleString('es-MX',{maximumFractionDigits:1}) },\n    pct(x){ return Math.min(100,Math.max(0,(Number(x||0)/Math.max(1,Number(this.s.procesados||0)))*100)) },\n    cmd(c){\n      this.ultimaOrden=({I:'INICIAR',P:'PAUSAR',R:'RESTABLECER',A:'AUTO',U:'ULTRA',F:'PRUEBA FALLO',Z:'PONER A CERO','1':'VELOCIDAD 1','2':'VELOCIDAD 2','3':'VELOCIDAD 3'})[c]||c;\n      this.send({payload:c});\n    }\n  }\n}\n</script>\n<style>\n.sf-panel{color:#e2e8f0;background:linear-gradient(145deg,#081426,#111827);padding:22px;border-radius:16px;font-family:Inter,system-ui,sans-serif;max-width:1400px;margin:auto}\n.sf-head{display:flex;justify-content:space-between;gap:15px;align-items:center;margin-bottom:22px;flex-wrap:wrap}.sf-head h1{font-size:28px;letter-spacing:-.6px;margin:4px 0;color:#fff;font-weight:800}.sf-head h1 span{color:#38bdf8}.sf-eyebrow{font-size:10px;letter-spacing:2px;font-weight:700;color:#94a3b8}.sf-sub,.sf-note,.sf-hint,.sf-footer{color:#94a3b8;font-size:12px}.sf-status{font-size:11px;letter-spacing:.4px;font-weight:700;border:1px solid #334155;border-radius:30px;padding:11px 14px;white-space:nowrap}.sf-online{color:#86efac}.sf-offline{color:#fda4af}.sf-dot{display:inline-block;background:currentColor;width:7px;height:7px;border-radius:50%;margin-right:7px;box-shadow:0 0 9px currentColor}.sf-alert{background:rgba(239,68,68,.12);border:1px solid #ef4444;color:#fecaca;padding:13px 16px;border-radius:9px;font-size:13px;margin-bottom:15px}.sf-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.sf-card,.sf-section{background:#172338;border:1px solid #29384e;border-radius:12px;padding:16px}.sf-card .sf-k{font-size:10px;color:#9eafc5;letter-spacing:.7px;font-weight:700}.sf-card .sf-n{font-size:32px;color:#fff;font-weight:800;margin:7px 0}.sf-green{color:#4ade80!important}.sf-yellow{color:#fbbf24!important}.sf-red{color:#f87171!important}.sf-blue{color:#38bdf8!important}.sf-columns{display:grid;grid-template-columns:1.12fr 1fr;gap:12px;margin-top:12px}.sf-section-title{font-size:12px;font-weight:800;letter-spacing:.7px;color:#e2e8f0;display:flex;gap:9px;align-items:center;justify-content:space-between}.sf-chip{font-size:10px;border:1px solid #64748b;padding:4px 8px;border-radius:15px}.sf-okchip{color:#4ade80;border-color:#15803d}.sf-warnchip{color:#fbbf24;border-color:#a16207}.sf-stategrid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-top:22px}.sf-stategrid div{border-bottom:1px solid #29384e;padding-bottom:9px;display:flex;flex-direction:column;gap:4px}.sf-stategrid span{font-size:11px;color:#93a6bc}.sf-stategrid strong{font-size:14px}.sf-mt{margin-top:22px;margin-bottom:12px}.sf-barrow{display:flex;gap:8px;align-items:center;margin:11px 0;font-size:11px}.sf-barrow span{width:73px}.sf-barrow b{width:35px;text-align:right}.sf-track{height:8px;border-radius:12px;background:#334155;flex:1;overflow:hidden}.sf-fill{height:100%;border-radius:12px;transition:width .3s}.sf-fillgreen{background:#22c55e}.sf-fillyellow{background:#eab308}.sf-fillred{background:#ef4444}.sf-controls{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}.sf-btn{border:1px solid #46566e;border-radius:8px;padding:10px 13px;color:#eff6ff;font-weight:700;font-size:11px;flex:1;cursor:pointer;min-width:85px;background:#253750;white-space:nowrap}.sf-btn:hover:not(:disabled){filter:brightness(1.3)}.sf-btn:disabled{opacity:.32;cursor:not-allowed}.sf-start{background:#166534;border-color:#15803d}.sf-stop{background:#991b1b;border-color:#dc2626}.sf-reset{background:#854d0e;border-color:#ca8a04}.sf-selected{background:#075985;border-color:#38bdf8}.sf-alt{background:#243449}.sf-warn{background:#78350f;border-color:#92400e}.sf-label{font-size:11px;color:#93a6bc;font-weight:700;margin-top:21px}.sf-label small{font-weight:400}.sf-divider{height:1px;background:#334155;margin:20px 0 4px}.sf-chartsection{margin-top:12px}.sf-chartmeta{display:flex;gap:36px;margin:20px 0 6px}.sf-chartmeta b{font-size:23px;color:#e0f2fe}.sf-chartmeta small{font-size:11px;color:#94a3b8}.sf-chart{display:block;width:100%;height:185px;background:linear-gradient(180deg,#1e293b,#0c1729);border-radius:9px;padding:10px}.sf-muted{font-size:10px;font-weight:400;color:#64748b}.sf-footer{text-align:center;margin-top:18px}.sf-hint{line-height:1.45;margin-top:12px}@media(max-width:900px){.sf-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.sf-columns{grid-template-columns:1fr}}@media(max-width:530px){.sf-panel{padding:10px}.sf-card .sf-n{font-size:24px}.sf-head h1{font-size:23px}.sf-stategrid{grid-template-columns:1fr}}\n</style>",
