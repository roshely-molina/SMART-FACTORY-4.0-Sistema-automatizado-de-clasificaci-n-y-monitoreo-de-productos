  {
    "id": "sf_fn_data",
    "type": "function",
    "z": "sf_tab4",
    "name": "Validar + indicadores + historial",
    "func": "// Saneamiento, indicadores y serie temporal de la telemetria.\nlet p = msg.payload;\nif (Buffer.isBuffer(p)) p=p.toString('utf8');\nif (typeof p==='string') { try { p=JSON.parse(p); } catch(e) { node.warn('JSON invalido'); return null; } }\nif (!p || typeof p!=='object' || p.dispositivo!=='SMART_FACTORY_4.0') return null;\nif (!['MARCHA','DETENIDA','ERROR_SENSOR','EMERGENCIA'].includes(p.estado)) return null;\nconst n = key => Number.isFinite(Number(p[key])) ? Math.max(0, Number(p[key])) : 0;\nconst t=Date.now();\nconst anterior=flow.get('sf_last') || null;\nlet historia=flow.get('sf_history') || [];\nif(anterior && n('procesados') < Number(anterior.procesados||0)) historia=[];\nhistoria.push({t, procesadas:n('procesados')});\nhistoria=historia.slice(-30);\nflow.set('sf_history',historia);\nconst procesadas=n('procesados');\nconst calidad=procesadas ? (n('adecuados')/procesadas*100) : 0;\nlet rendimiento_hora=0;\nif(historia.length>1){const inicio=historia[0],fin=historia[historia.length-1]; const dt=fin.t-inicio.t; if(dt>0) rendimiento_hora=Math.max(0,Math.round((fin.procesadas-inicio.procesadas)*3600000/dt));}\nconst s={\n estado:p.estado, modo:p.modo==='ULTRA'?'ULTRA':'AUTO',\n tamano:String(p.tamano||'SIN_OBJETO'), altura_cm:n('altura_cm'), distancia_cm:n('distancia_cm'),\n generados:n('generados'), procesados:procesadas, adecuados:n('adecuados'), pequenos:n('pequenos'), grandes:n('grandes'),\n fallos:n('fallos'), banda:p.banda===true, alarma:p.alarma===true, sensor_valido:p.sensor_valido===true,\n velocidad: (n('velocidad')>=1 && n('velocidad')<=3)?n('velocidad'):2,\n calidad:Number(calidad.toFixed(1)), rendimiento_hora,\n hora:new Date(t).toLocaleTimeString('es-MX',{hour12:false}), edad:0, online:true,\n historia, recibido:t\n};\nflow.set('sf_last',s);\nmsg.payload=s;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 425,
    "y": 120,
    "wires": [
      [
        "sf_ui_template",
        "sf_debug_data"
      ]
    ]
